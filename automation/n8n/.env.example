# Copy to .env on the Oracle VM next to docker-compose.yml. Never commit the real .env.

# Free wildcard DNS that resolves straight to your VM's public IP, no signup —
# format: <ip-with-dashes>.nip.io. Lets Caddy get a real Let's Encrypt cert
# without owning a real domain. Replace with your own domain later if you get one.
N8N_HOST=<VM_PUBLIC_IP_WITH_DASHES>.nip.io
WEBHOOK_URL=https://<VM_PUBLIC_IP_WITH_DASHES>.nip.io/

GENERIC_TIMEZONE=Asia/Kolkata
