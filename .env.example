# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# ===== Database =====
DB_NAME=puduvandi
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ===== JWT =====
# Generate a fresh one per environment — never reuse the same secret across
# dev/staging/prod, and never commit the real value:
#   openssl rand -base64 48
JWT_SECRET=

# staging | production — SecurityStartupValidator refuses to boot with the
# placeholder JWT secret when this is exactly "production".
PUDUVANDI_ENV=staging

# ===== CORS =====
# Extra allowed origin(s) beyond localhost/local-network (comma-separated).
# Defaults to the shared "https://*.vercel.app" wildcard, fine for test/staging
# but NOT for production — set this to your real frontend domain(s) before going live.
# CORS_EXTRA_ORIGINS=https://your-real-domain.com

# ===== OTP =====
# Keep mock mode on for staging/demo unless you want real SMS OTPs.
OTP_MOCK_ENABLED=true
OTP_MOCK_VALUE=123456

# ===== SMS/WhatsApp provider (MSG91) =====
# Leave MSG91_AUTHKEY blank to keep NotificationService in no-provider mode
# (every send logged as a non-retryable failure). Fill these in once your
# MSG91 account + DLT template registration are approved — see
# automation/n8n/MSG91_SETUP.md. Each *_TEMPLATE_* var is a separate DLT
# Template/Flow ID from the MSG91 dashboard (one per message type; TRAI
# requires an exact registered template per message, not one generic template).
# WhatsApp has no provider wired in yet (separate Meta template-approval process).
MSG91_AUTHKEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_PICKUP_REMINDER=
MSG91_TEMPLATE_RIDE_COMPLETION=
MSG91_TEMPLATE_OTP=

# ===== Payments (Razorpay) =====
# true = booking creation auto-confirms instantly, no gateway call (default).
# false = booking sits PAYMENT_PENDING until a real Razorpay payment is verified —
# requires RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET below (test keys from your Razorpay
# dashboard's Settings -> API Keys; never commit the real Key Secret).
PAYMENT_MOCK_ENABLED=true
PAYMENT_EXPIRY_MINUTES=15
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when registering the webhook URL (https://<host>/api/v1/webhooks/razorpay) in the
# Razorpay dashboard's Settings -> Webhooks. Subscribe to refund.processed and refund.failed.
RAZORPAY_WEBHOOK_SECRET=
